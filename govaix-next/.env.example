# Copy to .env.local. Leave unset to run every demo against local mocks
# (pages show a "(stubbed)" badge).
NEXT_PUBLIC_DEDALUS_API_URL=

# Integration keys are secrets: read them only from server code (route
# handlers / server actions). Never prefix them with NEXT_PUBLIC_, which would
# ship them to every visitor's browser.
# RANDOM_LABS_API_KEY=
# CRUSTDATA_API_KEY=
# LINGO_API_KEY=
# SHISA_API_KEY=
